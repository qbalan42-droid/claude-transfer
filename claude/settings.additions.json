{
  "hooks": {
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "jq -r '[(now|todate), .tool_name, (.tool_input|tostring)[0:200]] | @tsv' >> ~/.claude/audit.log 2>/dev/null || true" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "osascript -e 'display notification \"Claude needs your input\" with title \"Claude Code\"' 2>/dev/null || true" } ] }
    ]
  },
  "statusLine": { "type": "command", "command": "ccusage statusline" },
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "WebFetch", "WebSearch",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(find:*)", "Bash(rg:*)", "Bash(fd:*)", "Bash(mkdir:*)",
      "Bash(npm:*)", "Bash(curl:*)", "Bash(open:*)", "Bash(ffmpeg:*)", "Bash(pandoc:*)", "Bash(brew list:*)"
    ]
  }
}
